# BORN CINEMA — provider configuration
# The prototype runs fully on local mock providers when nothing is set.

# Set to "true" once /api/ai routes are implemented against a real model.
NEXT_PUBLIC_AI_TEXT_ENABLED=false

# Server-side only. Never expose to the browser.
# ANTHROPIC_API_KEY=
# AI_IMAGE_PROVIDER_KEY=
# AI_VIDEO_PROVIDER_KEY=

# --- OpenAI (text) ---
# Set this and every suggestion, structure, story, rewrite and partner reply comes from the model.
# Leave unset and the local creative partner answers (clearly labelled in the UI).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGES=0

# --- Sessions ---
# SESSION_SECRET=change-me
