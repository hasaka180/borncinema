# BORN CINEMA — provider configuration
# The prototype runs fully on local mock providers when nothing is set.

# Set to "true" once /api/ai routes are implemented against a real model.
NEXT_PUBLIC_AI_TEXT_ENABLED=false

# Server-side only. Never expose to the browser.
# ANTHROPIC_API_KEY=
# AI_IMAGE_PROVIDER_KEY=
# AI_VIDEO_PROVIDER_KEY=

# --- OpenAI (text) ---
# Set this and every suggestion, structure, story, rewrite and partner reply comes from the model.
# Leave unset and the local creative partner answers (clearly labelled in the UI).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGES=0

# --- Sessions ---
# SESSION_SECRET=change-me

# --- Appwrite (database) ---
# With these set the app uses Appwrite; without them it uses .data/db.json.
# Run `npm run appwrite:setup` once to create collections, indexes and demo accounts.
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_API_KEY=
# APPWRITE_DATABASE_ID=borncinema

# --- Local JSON store ---
# Only used when Appwrite is not configured. Point at a writable path on hosts with a
# read-only filesystem; otherwise the store runs in memory and nothing survives a restart.
# BC_DATA_DIR=/tmp/borncinema

# --- Cloudflare R2 (alternative to Cloudinary) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=borncinema
# NEXT_PUBLIC_R2_PUBLIC_URL=https://media.yourdomain.com
